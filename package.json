{
  "name": "tab-keeper-react-chrome-extension",
  "author": "Justine George",
  "description": "Efficiently save and synchronize tabs across devices without the need for personal logins.",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "prune-remote-code": "node ./scripts/prune_remote_code.mjs dist",
    "build:e2e": "npm run build && npm run prune-remote-code",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "npm run typecheck:e2e && npm run build:e2e && playwright test",
    "test": "vitest run",
    "test-dev": "vitest",
    "test-build": "npm run test && npm run build",
    "pretty": "npx prettier -w .",
    "pretty-build": "npm run pretty && npm run build",
    "lint": "eslint src e2e",
    "sync-versions": "node ./scripts/package_to_manifest.cjs",
    "bump-version": "node ./scripts/bump_version.cjs",
    "create-tag": "git tag v$(node -p \"require('./package.json').version\")",
    "push-tag": "git push origin v$(node -p \"require('./package.json').version\")",
    "release-artifact": "npm run create-tag && npm run push-tag",
    "release-local": "npm run pretty-build && cd dist && node ../scripts/zip.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.11.0",
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "i18next-http-backend": "^4.0.1",
    "js-base64": "^3.9.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.12",
    "react-redux": "^8.1.1",
    "redux-thunk": "^2.4.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.7",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.1.1",
    "bestzip": "^2.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-localstorage-mock": "^0.1.2"
  }
}
