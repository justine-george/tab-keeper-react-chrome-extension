{
  "manifest_version": 3,
  "version": "1.9.0",
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon128.png",
    "default_title": "__MSG_appName__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Tab Keeper"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "favicon"],
  "optional_permissions": ["tabGroups"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
